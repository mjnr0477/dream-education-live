<script>
(function () {
  const learnerId =
    localStorage.getItem("dream_education_learner_id") ||
    `learner_${crypto.randomUUID()}`;
localStorage.setItem("dream_education_learner_id", learnerId);

  const subject = document.getElementById("learn-subject");
  const topic = document.getElementById("learn-topic");
  const method = document.getElementById("learn-method");
  const customMethod = document.getElementById("custom-method");
  const customWrap = document.getElementById("custom-method-wrap");
  const question = document.getElementById("learn-question");

  const startBtn = document.getElementById("start-learning-btn");
  const submitBtn = document.getElementById("submit-answer-btn");
  const continueBtn = document.getElementById("continue-learning-btn");

  const response = document.getElementById("learning-response");
  const answer = document.getElementById("teaching-answer");
  const learnerAnswer = document.getElementById("learner-answer");
  const adaptiveResult = document.getElementById("adaptive-result");
  const stateBadge = document.getElementById("learning-state-badge");
  const responseTopic = document.getElementById("response-topic");
  const responseMethod = document.getElementById("response-method");

  let currentSession = null;

  method.addEventListener("change", function () {
    customWrap.classList.toggle("hidden", method.value !== "custom");
  });

  function setLoading(button, loading, normalText) {
    button.disabled = loading;
    button.textContent = loading ? "Working..." : normalText;
  }

  function showResponse() {
    response.classList.remove("hidden");
    response.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function displayTeaching(data) {
    answer.innerHTML = String(data.answer || data.message || "Let's begin learning.").replace(/\\n/g, "<br>").replace(/\n/g, "<br>");
    responseTopic.textContent =
      data.topic ? "Topic: " + data.topic : "";
    responseMethod.textContent =
      method.value === "custom"
        ? "Method: " + (customMethod.value || "Custom")
        : "Method: " + method.value;
    showResponse();
  }

  async function startLearning() {
    if (!subject.value || !question.value.trim()) {
      alert("Choose a subject and enter what you want to learn.");
      return;
    }

    setLoading(startBtn, true, "Start Learning");

    try {
      const payload = {
        learner_id: learnerId,
        question: question.value.trim(),
        subject: subject.value,
        topic: topic.value.trim() || null,
        level: "Junior Secondary",
        learning_method: method.value,
        custom_learning_method:
          method.value === "custom"
            ? customMethod.value.trim()
            : null
      };

      const res = await fetch("/api/learn", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (!data.success) {
        throw new Error(data.error || "Learning request failed");
      }

      currentSession = {
        subject: subject.value,
        topic: topic.value.trim() || data.topic || null
      };

      displayTeaching(data);
      learnerAnswer.value = "";
      adaptiveResult.classList.add("hidden");
      continueBtn.classList.add("hidden");
    } catch (error) {
      answer.textContent = "I couldn't start the lesson: " + error.message;
      showResponse();
    } finally {
      setLoading(startBtn, false, "Start Learning");
    }
  }

  async function submitAnswer() {
    if (!learnerAnswer.value.trim()) {
      alert("Write your answer first.");
      return;
    }

    setLoading(submitBtn, true, "Check My Answer");

    try {
      const payload = {
        learner_id: learnerId,
        name: "Demo Learner",
        question: question.value.trim(),
        learner_answer: learnerAnswer.value.trim(),
        subject: currentSession?.subject || subject.value,
        topic: currentSession?.topic || topic.value.trim() || null,
        level: "Junior Secondary",
        learning_method: method.value,
        custom_learning_method:
          method.value === "custom"
            ? customMethod.value.trim()
            : null
      };

      const res = await fetch("/api/session", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (!data.success) {
        throw new Error(data.error || "Assessment failed");
      }

      stateBadge.textContent = data.learning_state || "UPDATED";

      adaptiveResult.innerHTML = "";

      const score = document.createElement("strong");
      score.textContent =
        "Score: " + (data.assessment?.score ?? 0) + "%";

      const state = document.createElement("div");
      state.textContent =
        "Learning state: " + (data.learning_state || "UPDATED");

      const feedback = document.createElement("div");
      feedback.textContent =
        data.assessment?.feedback || "Your answer has been assessed.";

      adaptiveResult.append(score, state, feedback);

      if (data.next_question?.question) {
        const nextLabel = document.createElement("div");
        nextLabel.textContent = "NEXT LEARNING TASK";
        nextLabel.style.marginTop = "18px";
        nextLabel.style.fontSize = "10px";
        nextLabel.style.fontWeight = "800";
        nextLabel.style.letterSpacing = "1.2px";
        nextLabel.style.opacity = ".55";

        const next = document.createElement("div");
        next.textContent = data.next_question.question;
        next.style.marginTop = "7px";
        next.style.fontSize = "17px";
        next.style.fontWeight = "700";
        next.style.lineHeight = "1.5";

        adaptiveResult.append(nextLabel, next);
      }

      adaptiveResult.classList.remove("hidden");
      continueBtn.classList.remove("hidden");

      currentSession = {
        ...currentSession,
        nextQuestion: data.next_question,
        learningState: data.learning_state,
        assessment: data.assessment
      };

      showResponse();

    } catch (error) {
      adaptiveResult.textContent =
        "I couldn't check the answer: " + error.message;
      adaptiveResult.classList.remove("hidden");
    } finally {
      setLoading(submitBtn, false, "Check My Answer");
    }
  }

  function continueLearning() {
    if (!currentSession?.nextQuestion?.question) return;

    question.value = currentSession.nextQuestion.question;

    topic.value =
      currentSession.nextQuestion.topic ||
      topic.value;

    if (currentSession.nextQuestion.subject) {
      subject.value = currentSession.nextQuestion.subject;
    }

    learnerAnswer.value = "";

    adaptiveResult.classList.add("hidden");
    continueBtn.classList.add("hidden");

    response.classList.remove("hidden");

    question.focus();

    window.scrollTo({
      top: question.getBoundingClientRect().top +
        window.scrollY -
        120,
      behavior: "smooth"
    });
  }

  startBtn.addEventListener("click", startLearning);
  submitBtn.addEventListener("click", submitAnswer);
  continueBtn.addEventListener("click", continueLearning);
})();

  
  let learnerId =
  localStorage.getItem("dream_education_learner_id") ||
  `learner_${crypto.randomUUID()}`;
localStorage.setItem("dream_education_learner_id", learnerId);

const roleEntry = document.getElementById("role-entry");
  const learnerName = document.getElementById("learner-name");
  const learnerLevel = document.getElementById("learner-level");
  const learnerSchool = document.getElementById("learner-school");
  const learnerContinueBtn = document.getElementById("learner-continue-btn");
  const learnerBackBtn = document.getElementById("learner-back-btn");
  const authEntry = document.getElementById("auth-entry");
  const authTitle = document.getElementById("auth-title");
  const authDescription = document.getElementById("auth-description");
  const authEmail = document.getElementById("auth-email");
  const authPassword = document.getElementById("auth-password");
  const authNameWrap = document.getElementById("auth-name-wrap");
  const authSubmitBtn = document.getElementById("auth-submit-btn");
  const authToggleBtn = document.getElementById("auth-toggle-btn");
  const authBackBtn = document.getElementById("auth-back-btn");
  const authMessage = document.getElementById("auth-message");
  let authMode = "login";

  function updateAuthMode() {
    const registering = authMode === "register";
    authTitle.textContent = registering
      ? "Create your Dream Education account."
      : "Welcome back.";
    authDescription.textContent = registering
      ? "Create your account to save your learning journey."
      : "Log in to continue your learning journey.";
    authNameWrap.classList.toggle("hidden", !registering);
    authSubmitBtn.textContent = registering ? "Create Account" : "Log In";
    authToggleBtn.textContent = registering
      ? "I already have an account"
      : "Create an account";
    authMessage.classList.add("hidden");
  }



  async function submitAuth() {
    const email = authEmail.value.trim();
    const password = authPassword.value;

    if (!email || !password) {
      authMessage.textContent = "Email and password are required.";
      authMessage.classList.remove("hidden");
      return;
    }

    if (authMode === "register") {
      const name = document.getElementById("auth-name").value.trim();
      const level = document.getElementById("auth-level").value;
      const grade = document.getElementById("auth-grade").value.trim();
      const school = document.getElementById("auth-school").value.trim();

      if (!name) {
        authMessage.textContent = "Please enter your name.";
        authMessage.classList.remove("hidden");
        return;
      }

      const response = await fetch("/api/auth/register", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          email,
          password,
          name,
          level,
          grade,
          school: school || null
        })
      });

      const data = await response.json();

      if (!data.success) {
        throw new Error(data.error || "Registration failed.");
      }

      learnerId = data.learner.learner_id;
      localStorage.setItem("dream_education_learner_id", learnerId);

      if (data.account?.account_id) {
        localStorage.setItem(
          "dream_education_account_id",
          data.account.account_id
        );
      }

      if (data.session) {
        localStorage.setItem(
          "dream_education_access_token",
          data.session.access_token
        );
        localStorage.setItem(
          "dream_education_refresh_token",
          data.session.refresh_token
        );
      }
    } else {
      const response = await fetch("/api/auth/login", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          email,
          password
        })
      });

      const data = await response.json();

      if (!data.success) {
        throw new Error(data.error || "Login failed.");
      }

      learnerId = data.learner?.learner_id || data.account?.learner_id;

      if (learnerId) {
        localStorage.setItem("dream_education_learner_id", learnerId);
      }

      if (data.account?.account_id) {
        localStorage.setItem(
          "dream_education_account_id",
          data.account.account_id
        );
      }

      if (data.session) {
        localStorage.setItem(
          "dream_education_access_token",
          data.session.access_token
        );
        localStorage.setItem(
          "dream_education_refresh_token",
          data.session.refresh_token
        );
      }
    }

    authEntry.classList.add("hidden");
    learnerDashboard.classList.remove("hidden");
    loadLearnerDashboard();

    learnerDashboard.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  }

  authSubmitBtn.addEventListener("click", async function () {
    try {
      authSubmitBtn.disabled = true;
      await submitAuth();
    } catch (error) {
      authMessage.textContent = error.message;
      authMessage.classList.remove("hidden");
      console.error("Authentication error:", error);
    } finally {
      authSubmitBtn.disabled = false;
    }
  });

  authToggleBtn.addEventListener("click", function () {
    authMode = authMode === "login" ? "register" : "login";
    updateAuthMode();
  });

  authBackBtn.addEventListener("click", function () {
    authEntry.classList.add("hidden");
    roleEntry.classList.remove("hidden");
  });

  document.querySelectorAll(".role-option").forEach(function (button) {
    button.addEventListener("click", function () {
      const selectedRole = button.dataset.role;

      roleEntry.classList.add("hidden");

      if (selectedRole === "learner") {
        authEntry.classList.remove("hidden");
        authMode = "login";
        updateAuthMode();
        authEmail.focus();
        return;
      }

      if (selectedRole === "parent") {
        document.getElementById("parent-dashboard").classList.remove("hidden");
        document.getElementById("parent-dashboard-welcome").textContent =
          "Parent Dashboard";
        return;
      }

      if (selectedRole === "teacher") {
        document.getElementById("teacher-dashboard").classList.remove("hidden");
        document.getElementById("teacher-dashboard-welcome").textContent =
          "Teacher Dashboard";
        return;
      }

      if (selectedRole === "school") {
        document.getElementById("school-dashboard").classList.remove("hidden");
        document.getElementById("school-dashboard-welcome").textContent =
          "School Dashboard";
        return;
      }
    });
  });


  
  const learnerGrade = document.getElementById("learner-grade");

  const gradeOptions = {
    "Pre-Primary": ["PP1", "PP2"],
    "Primary": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Grade 6"],
    "Junior Secondary": ["Grade 7", "Grade 8", "Grade 9"],
    "Senior Secondary": ["Grade 10", "Grade 11", "Grade 12"],
    "Tertiary": ["Year 1", "Year 2", "Year 3", "Year 4"]
  };

  function updateGradeOptions() {
    const options = gradeOptions[learnerLevel.value] || [];

    learnerGrade.innerHTML = options
      .map(function (grade) {
        return '<option value="' + grade + '">' + grade + '</option>';
      })
      .join("");
  }

  learnerLevel.addEventListener("change", updateGradeOptions);
  updateGradeOptions();

  learnerBackBtn.addEventListener("click", function () {
    roleEntry.classList.remove("hidden");
  });

  
  
  const learnerDashboard = document.getElementById("learner-dashboard");
  const dashboardWelcome = document.getElementById("dashboard-welcome");
  const dashboardEducation = document.getElementById("dashboard-education");
  const dashboardSchool = document.getElementById("dashboard-school");
  const dashboardTopic = document.getElementById("dashboard-topic");
  const dashboardState = document.getElementById("dashboard-state");
  const dashboardTopics = document.getElementById("dashboard-topics");
  const dashboardMastery = document.getElementById("dashboard-mastery");
  const dashboardAverage = document.getElementById("dashboard-average");
  const dashboardContinueBtn = document.getElementById("dashboard-continue-btn");
  const dashboardSubjectsBtn = document.getElementById("dashboard-subjects-btn");
  const dashboardSubjectsPanel = document.getElementById("dashboard-subjects-panel");

  let learnerDashboardData = null;

async function loadLearnerDashboard() {
    try {
      const accessToken =
        localStorage.getItem("dream_education_access_token");

      const res = await fetch(
        "/api/product/learner/" + encodeURIComponent(learnerId) + "/dashboard",
        {
          headers: accessToken
            ? {
                "Authorization": "Bearer " + accessToken
              }
            : {}
        }
      );

      const data = await res.json();

      if (!data.success) {
        throw new Error(data.message || "Could not load dashboard.");
      }

      learnerDashboardData = data;

    const learner = data.learner || {};
      const learning = data.learning || {};
      const progress = learning.progress || {};
      const schools = data.education?.schools || [];

      dashboardWelcome.textContent =
        "Welcome back, " + (learner.name || "Learner") + ".";

      dashboardEducation.textContent =
      [learner.level, learner.grade]
        .filter(Boolean)
        .join(" · ");

    dashboardSchool.textContent =
        schools.length ? schools[0].name : "";

      dashboardTopic.textContent =
        learning.active_topic || data.next?.topic || "Start learning";

      dashboardState.textContent =
        learning.learning_state
          ? "Learning state: " + learning.learning_state
          : "Ready for your next learning step.";

      dashboardTopics.textContent =
        progress.topics_started ?? 0;

      dashboardMastery.textContent =
        learning.mastery_status || "—";

      dashboardAverage.textContent =
        Math.round(progress.average_score || 0) + "%";

    } catch (error) {
      dashboardWelcome.textContent = "Welcome back.";
      dashboardState.textContent =
        "We couldn't load your latest progress.";
      console.error("Dashboard error:", error);
    }
  }

  const dashboardHistoryBtn =
    document.getElementById("dashboard-history-btn");
  const dashboardProgressBtn =
    document.getElementById("dashboard-progress-btn");
  const dashboardHistoryPanel =
    document.getElementById("dashboard-history-panel");
  const dashboardProgressPanel =
    document.getElementById("dashboard-progress-panel");
  const dashboardHistoryContent =
    document.getElementById("dashboard-history-content");
  const dashboardProgressContent =
    document.getElementById("dashboard-progress-content");

  function hideDashboardPanels() {
    dashboardSubjectsPanel.classList.add("hidden");
    dashboardHistoryPanel?.classList.add("hidden");
    dashboardProgressPanel?.classList.add("hidden");
  }

  dashboardSubjectsBtn.addEventListener("click", function () {
    const opening =
      dashboardSubjectsPanel.classList.contains("hidden");

    hideDashboardPanels();

    if (opening) {
      dashboardSubjectsPanel.classList.remove("hidden");
      dashboardSubjectsPanel.scrollIntoView({
        behavior: "smooth",
        block: "center"
      });
    }
  });

  dashboardHistoryBtn?.addEventListener("click", function () {
    const data = learnerDashboardData || {};
    const results = data.results || {};
    const recent = Array.isArray(results.recent)
      ? results.recent
      : [];

    hideDashboardPanels();

    if (!recent.length) {
      dashboardHistoryContent.innerHTML =
        "<p>You haven't completed any learning activities yet.</p>";
    } else {
      dashboardHistoryContent.innerHTML = recent
        .slice()
        .reverse()
        .map(function (result) {
          const topic =
            result.topic ||
            result.subject ||
            "Learning activity";

          const score =
            Number.isFinite(Number(result.score))
              ? Math.round(Number(result.score)) + "%"
              : "Score not recorded";

          const date = result.created_at
            ? new Date(result.created_at).toLocaleString()
            : "";

          return (
            '<div class="dashboard-history-item">' +
            "<strong>" + topic + "</strong>" +
            "<span>" + score + "</span>" +
            (date ? "<small>" + date + "</small>" : "") +
            "</div>"
          );
        })
        .join("");
    }

    dashboardHistoryPanel.classList.remove("hidden");
    dashboardHistoryPanel.scrollIntoView({
      behavior: "smooth",
      block: "center"
    });
  });

  dashboardProgressBtn?.addEventListener("click", function () {
    const data = learnerDashboardData || {};
    const results = data.results || {};
    const learning = data.learning || {};
    const bySubject = results.by_subject || {};
    const byTopic = results.by_topic || {};

    hideDashboardPanels();

    let html =
      '<div class="dashboard-progress-summary">' +
      "<p><strong>Average score:</strong> " +
      (Number.isFinite(Number(results.average_score))
        ? Math.round(Number(results.average_score)) + "%"
        : "0%") +
      "</p>" +
      "<p><strong>Mastery:</strong> " +
      (learning.mastery_status || "Not started") +
      "</p>" +
      "<p><strong>Learning state:</strong> " +
      (learning.learning_state || "Ready") +
      "</p>" +
      "</div>";

    const subjectNames = Object.keys(bySubject);

    if (subjectNames.length) {
      html += "<h3>By subject</h3><ul>";

      subjectNames.forEach(function (subject) {
        const item = bySubject[subject] || {};
        const average =
          Number.isFinite(Number(item.average_score))
            ? Math.round(Number(item.average_score)) + "%"
            : "—";

        html +=
          "<li><strong>" +
          subject +
          "</strong>: " +
          average +
          "</li>";
      });

      html += "</ul>";
    }

    const topicNames = Object.keys(byTopic);

    if (topicNames.length) {
      html += "<h3>By topic</h3><ul>";

      topicNames.forEach(function (topic) {
        const item = byTopic[topic] || {};
        const average =
          Number.isFinite(Number(item.average_score))
            ? Math.round(Number(item.average_score)) + "%"
            : "—";

        html +=
          "<li><strong>" +
          topic +
          "</strong>: " +
          average +
          "</li>";
      });

      html += "</ul>";
    }

    if (!subjectNames.length && !topicNames.length) {
      html +=
        "<p>Your detailed progress will appear here as you learn.</p>";
    }

    dashboardProgressContent.innerHTML = html;

    dashboardProgressPanel.classList.remove("hidden");
    dashboardProgressPanel.scrollIntoView({
      behavior: "smooth",
      block: "center"
    });
  });

  document.querySelectorAll("[data-dashboard-subject]").forEach(function (button) {
  button.addEventListener("click", async function () {
    const selectedSubject = button.dataset.dashboardSubject;

    const learningSubject = document.getElementById("learn-subject");
    const learningTopic = document.getElementById("learn-topic");
    const learningQuestion = document.getElementById("learn-question");

    const topicsPanel = document.getElementById("dashboard-topics-panel");
    const topicsTitle = document.getElementById("dashboard-topics-title");
    const topicList = document.getElementById("dashboard-topic-list");

    if (learningSubject) learningSubject.value = selectedSubject;
    if (learningTopic) learningTopic.value = "";
    if (learningQuestion) learningQuestion.value = "";

    topicsTitle.textContent = selectedSubject + " topics";
    topicList.innerHTML = "<p>Loading topics...</p>";

    dashboardSubjectsPanel.classList.add("hidden");
    topicsPanel.classList.remove("hidden");

    try {
      const currentLevel =
        document.getElementById("learner-level")?.value ||
        "Junior Secondary";

      const response = await fetch(
        "/api/product/curriculum/topics?subject=" +
        encodeURIComponent(selectedSubject) +
        "&level=" +
        encodeURIComponent(currentLevel)
      );

      const data = await response.json();

      if (!data.success) {
        throw new Error(data.error || "Could not load topics.");
      }

      const topics = [];

      (data.strands || []).forEach(function (strand) {
        (strand.topics || []).forEach(function (topicName) {
          topics.push({
            strand: strand.strand,
            topic: topicName
          });
        });
      });

      if (!topics.length) {
        topicList.innerHTML = "<p>No topics are available for this level yet.</p>";
        return;
      }

      topicList.innerHTML = topics.map(function (item) {
        return (
          '<button type="button" class="dashboard-topic-option" ' +
          'data-dashboard-topic="' + item.topic.replace(/"/g, "&quot;") + '">' +
          '<strong>' + item.topic + '</strong>' +
          '<span>' + item.strand + '</span>' +
          '</button>'
        );
      }).join("");

      topicList.querySelectorAll("[data-dashboard-topic]").forEach(function (topicButton) {
        topicButton.addEventListener("click", async function () {
          const selectedTopic = topicButton.dataset.dashboardTopic;

          const conceptsPanel =
            document.getElementById("dashboard-concepts-panel");
          const conceptsTitle =
            document.getElementById("dashboard-concepts-title");
          const conceptList =
            document.getElementById("dashboard-concept-list");

          if (learningTopic) learningTopic.value = selectedTopic;
          if (learningQuestion) learningQuestion.value = "";

          conceptsTitle.textContent = selectedTopic + " concepts";
          conceptList.innerHTML = "<p>Loading concepts...</p>";

          topicsPanel.classList.add("hidden");
          conceptsPanel.classList.remove("hidden");

          try {
            const currentLevel =
              document.getElementById("learner-level")?.value ||
              "Junior Secondary";

            const selectedSubject =
              document.getElementById("learn-subject")?.value ||
              "";

            const response = await fetch(
              "/api/product/curriculum/concepts?subject=" +
              encodeURIComponent(selectedSubject) +
              "&level=" +
              encodeURIComponent(currentLevel) +
              "&topic=" +
              encodeURIComponent(selectedTopic)
            );

            const data = await response.json();

            if (!data.success) {
              throw new Error(data.error || "Could not load concepts.");
            }

            const concepts = data.concepts || [];

            if (!concepts.length) {
              conceptList.innerHTML =
                "<p>No concepts are available for this topic yet.</p>";
              return;
            }

            conceptList.innerHTML = concepts.map(function (concept) {
              return (
                '<button type="button" class="dashboard-concept-option" ' +
                'data-dashboard-concept="' +
                concept.name.replace(/"/g, "&quot;") +
                '">' +
                '<strong>' + concept.name + '</strong>' +
                '<span class="concept-definition">' +
                (concept.definition || "Explore this concept.") +
                '</span>' +
                '</button>'
              );
            }).join("");

            conceptList
              .querySelectorAll("[data-dashboard-concept]")
              .forEach(function (conceptButton) {
                conceptButton.addEventListener("click", async function () {
                  const selectedConcept =
                    conceptButton.dataset.dashboardConcept;

                  const learningSubject =
                    document.getElementById("learn-subject");
                  const learningTopic =
                    document.getElementById("learn-topic");
                  const learningQuestion =
                    document.getElementById("learn-question");
                  if (learningSubject) {
                    learningSubject.value = selectedSubject;
                  }

                  if (learningTopic) {
                    learningTopic.value = selectedTopic;
                  }

                  if (learningQuestion) {
                    learningQuestion.value =
                      "Teach me about " + selectedConcept + ".";
                  }

                  conceptsPanel.classList.add("hidden");

                  const learningPanel =
                    document.querySelector(".live-learning-panel");

                  if (learningPanel) {
                    learningPanel.classList.remove("hidden");
                    learningPanel.scrollIntoView({
                      behavior: "smooth",
                      block: "start"
                    });
                  }
                });
              });

            conceptsPanel.scrollIntoView({
              behavior: "smooth",
              block: "center"
            });

          } catch (error) {
            conceptList.innerHTML =
              "<p>We couldn't load the concepts: " +
              error.message +
              "</p>";

            console.error("Curriculum concept error:", error);
          }
        });
      });

      topicsPanel.scrollIntoView({
        behavior: "smooth",
        block: "center"
      });

    } catch (error) {
      topicList.innerHTML =
        "<p>We couldn't load the topics: " + error.message + "</p>";
      console.error("Curriculum topic error:", error);
    }
  });
});

dashboardContinueBtn.addEventListener("click", function () {
    const learningPanel =
      document.querySelector(".live-learning-panel");

    if (learningPanel) {
      learningPanel.classList.remove("hidden");
      learningPanel.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });
    }
  });

learnerContinueBtn.addEventListener("click", async function () {
    const name = learnerName.value.trim();

    if (!name) {
      learnerName.focus();
      learnerName.reportValidity();
      return;
    }

    try {
      const profileResponse = await fetch("/api/product/learner", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          learner_id: learnerId,
          name: name,
          level: learnerLevel.value,
          grade: learnerGrade.value,
          school: learnerSchool.value.trim() || null
        })
      });

      const profileData = await profileResponse.json();

      if (!profileData.success) {
        throw new Error(profileData.error || "Could not save learner profile.");
      }

      if (profileData.learner?.learner_id) {
      localStorage.setItem(
        "dream_education_learner_id",
        profileData.learner.learner_id
      );
    }

      learnerDashboard.classList.remove("hidden");
      loadLearnerDashboard();

      learnerDashboard.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });

    } catch (error) {
      alert("We couldn't save your learner profile: " + error.message);
      console.error("Learner profile error:", error);
    }
  });
</script>


