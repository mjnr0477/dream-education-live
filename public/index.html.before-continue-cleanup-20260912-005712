        <p id="dashboard-state"></p>
        <button id="dashboard-continue-btn" type="button">Continue Learning</button>
      </div>

      <div class="dashboard-card">
        <div class="dashboard-card-label">YOUR PROGRESS</div>

        <div class="dashboard-stats">
          <div>
            <strong id="dashboard-topics">0</strong>
            <span>Topics started</span>
          </div>

