    <div class="dashboard-actions">
        <button type="button" id="dashboard-subjects-btn">Subjects</button>
        <button type="button" id="dashboard-history-btn">Learning History</button>
        <button type="button" id="dashboard-progress-btn">Progress</button>
      </div>

    </div>
  

  <!-- DREAM EDUCATION LIVE LEARNING EXPERIENCE -->
<section id="live-learning" class="live-learning-panel hidden">
  <div class="live-learning-header">
    <div>
      <span class="section-label">LEARN</span>
      <h2>Learn your way</h2>
      <p>Choose what you want to learn and how you want Dream Education to teach you.</p>
    </div>
    <div id="learning-state-badge" class="learning-state-badge">READY</div>
  </div>

  <div class="learning-controls">
    <label>
      Subject
      <select id="learn-subject">
        <option value="">Choose subject</option>
        <option value="Biology">Biology</option>
        <option value="Integrated Science">Integrated Science</option>
        <option value="Mathematics">Mathematics</option>
        <option value="Physics">Physics</option>
      </select>
    </label>

    <label>
      Topic
      <input id="learn-topic" type="text" placeholder="e.g. Photosynthesis">
    </label>

    <label>
      How should I teach you?
      <select id="learn-method">
        <option value="auto">Choose automatically</option>
        <option value="explanation">Explain it simply</option>
        <option value="examples">Use examples</option>
        <option value="step_by_step">Step by step</option>
        <option value="discussion">Discuss it with me</option>
        <option value="problem_solving">Problem solving</option>
        <option value="custom">My own method</option>
      </select>
    </label>

    <label id="custom-method-wrap" class="hidden">
      Your method
      <input id="custom-method" type="text" placeholder="Describe how you want to learn">
    </label>
  </div>

  <div class="learning-question-box">
    <label for="learn-question">What do you want to learn?</label>
    <textarea id="learn-question" rows="3" placeholder="Ask a question..."></textarea>
    <button id="start-learning-btn" type="button">Start Learning</button>
  </div>

  <div id="learning-response" class="learning-response hidden">
    <div class="response-meta">
      <span id="response-topic"></span>
      <span id="response-method"></span>
    </div>

    <div id="teaching-answer" class="teaching-answer"></div>

    <div id="answer-area" class="answer-area">
      <label for="learner-answer">Your answer</label>
      <textarea id="learner-answer" rows="4" placeholder="Show me what you understand..."></textarea>
      <button id="submit-answer-btn" type="button">Check My Answer</button>
    </div>

    <div id="adaptive-result" class="adaptive-result hidden"></div>

    <button id="continue-learning-btn" class="hidden" type="button">
      Continue Learning
    </button>
  </div>
</section>
