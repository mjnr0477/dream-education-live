<body>
  <section id="role-entry" class="role-entry">
    <div class="role-entry-card">
      <div class="section-label">DREAM EDUCATION</div>
      <h1>Learn in the way that works for you.</h1>
      <p>Welcome. Choose your role to enter your dashboard and continue from where you left off.</p>

      <div class="role-options">
        <button type="button" class="role-option" data-role="learner">
          <strong>I'm a Learner</strong>
          <span>Learn, practise, track progress and build mastery.</span>
        </button>

        <button type="button" class="role-option" data-role="teacher">
          <strong>I'm a Teacher</strong>
          <span>Support learners and understand class performance.</span>
        </button>

        <button type="button" class="role-option" data-role="parent">
          <strong>I'm a Parent</strong>
          <span>Follow your child's learning and progress.</span>
        </button>

        <button type="button" class="role-option" data-role="school">
          <strong>I'm a School</strong>
          <span>Manage learners, classes, results and analytics.</span>
        </button>
      </div>
    </div>
  </section>
  
  
  <section id="learner-dashboard" class="role-entry hidden">
    <div class="learner-dashboard-card">

      <div class="dashboard-header">
