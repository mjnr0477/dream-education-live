          </div>
        </div>
      </div>

      <div id="dashboard-subjects-panel" class="dashboard-card hidden">
        <div class="dashboard-card-label">SUBJECTS</div>
        <h2>What do you want to learn?</h2>
        <div class="dashboard-subject-list">
          <button type="button" data-dashboard-subject="Biology">Biology</button>
          <button type="button" data-dashboard-subject="Integrated Science">Integrated Science</button>
