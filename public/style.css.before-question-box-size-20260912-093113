   ========================================================= */

.live-learning-panel {
  width: calc(100% - 24px);
  max-width: 1200px;
  min-height: 80vh;
  margin: 30px auto;
  padding: clamp(28px, 5vw, 55px);
  border-radius: 30px;
}

.live-learning-header {
  padding-bottom: 20px;
}

.live-learning-header h2 {
  font-size: clamp(32px, 6vw, 52px);
  margin: 12px 0;
  line-height: 1.08;
}

.live-learning-header p {
  font-size: clamp(17px, 2vw, 20px);
  line-height: 1.7;
}

/* Concept being studied */
.selected-concept-context {
  padding: 22px 24px;
  margin: 20px 0 30px;
  border-radius: 18px;
}

.selected-concept-context strong {
  display: block;
  font-size: clamp(22px, 4vw, 30px);
  margin-top: 8px;
}

/* Learning choices */
.live-learning-panel .learning-controls {
  gap: 26px;
  margin-top: 32px;
}

.live-learning-panel .learning-controls label {
  font-size: 16px;
  font-weight: 750;
  gap: 11px;
}

.live-learning-panel select,
.live-learning-panel input {
  min-height: 58px;
  padding: 16px 18px;
  font-size: 17px;
  border-radius: 15px;
}

/* Main question area */
.live-learning-panel .learning-question-box {
  margin-top: 36px;
  padding: clamp(24px, 4vw, 38px);
  border-radius: 24px;
}

.live-learning-panel .learning-question-box label {
  font-size: 18px;
  font-weight: 800;
}

.live-learning-panel .learning-question-box textarea {
  min-height: 180px;
  margin-top: 12px;
  padding: 18px;
  font-size: 18px;
  line-height: 1.6;
  border-radius: 16px;
}

/* Main learning button */
.live-learning-panel #start-learning-btn {
  min-height: 70px;
  font-size: 20px;
  margin-top: 18px;
  border-radius: 17px;
}

/* AI teaching response */
.live-learning-panel .learning-response {
  margin-top: 36px;
  padding: clamp(26px, 5vw, 45px);
  border-radius: 25px;
}

.live-learning-panel .response-meta {
  font-size: 15px;
  margin-bottom: 24px;
}

.live-learning-panel .teaching-answer {
  font-size: clamp(19px, 3vw, 23px);
  line-height: 1.85;
  min-height: 180px;
}

/* Learner answer */
.live-learning-panel .answer-area {
  margin-top: 38px;
}

.live-learning-panel .answer-area label {
  font-size: 18px;
  font-weight: 800;
}

.live-learning-panel #learner-answer {
  min-height: 210px;
  margin-top: 12px;
  padding: 18px;
  font-size: 18px;
  line-height: 1.65;
  border-radius: 16px;
}

.live-learning-panel #submit-answer-btn {
  min-height: 68px;
  font-size: 19px;
  border-radius: 17px;
}

/* Assessment / adaptive feedback */
.live-learning-panel .adaptive-result {
  margin-top: 30px;
  padding: 25px;
  font-size: 18px;
  line-height: 1.7;
  border-radius: 20px;
}

/* Big next-step button */
.live-learning-panel #continue-learning-btn {
  min-height: 82px;
  margin-top: 28px;
  font-size: 21px;
  border-radius: 18px;
}

/* Phone: use the screen properly */
@media (max-width: 700px) {
  .live-learning-panel {
    width: calc(100% - 12px);
    min-height: 85vh;
    margin: 18px auto;
    padding: 26px 16px;
    border-radius: 24px;
  }

  .live-learning-header h2 {
    font-size: 34px;
  }

  .live-learning-panel .learning-controls {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .live-learning-panel .learning-question-box {
    padding: 22px 16px;
  }

  .live-learning-panel .learning-question-box textarea {
    min-height: 190px;
    font-size: 17px;
  }

  .live-learning-panel .learning-response {
    padding: 24px 17px;
  }

  .live-learning-panel .teaching-answer {
    font-size: 19px;
    line-height: 1.8;
  }

  .live-learning-panel #learner-answer {
    min-height: 220px;
  }

  .live-learning-panel #start-learning-btn,
  .live-learning-panel #submit-answer-btn,
  .live-learning-panel #continue-learning-btn {
    min-height: 72px;
  }
}

