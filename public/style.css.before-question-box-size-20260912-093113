* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #f5f7fc;
  --surface: #ffffff;
  --surface-soft: #f8f9fd;
  --surface-strong: #eef1ff;

  --text: #111827;
  --text-soft: #344054;
  --muted: #667085;

  --primary: #4f46e5;
  --primary-dark: #3730a3;
  --primary-soft: #eef2ff;

  --success: #087f5b;
  --success-soft: #ecfdf5;

  --warning: #b45309;
  --warning-soft: #fffbeb;

  --danger: #b42318;
  --danger-soft: #fef3f2;

  --border: #e6e8f0;
  --border-strong: #d8dbea;

  --shadow-sm: 0 2px 8px rgba(16, 24, 40, 0.04);
  --shadow-md: 0 12px 35px rgba(16, 24, 40, 0.07);
  --shadow-lg: 0 25px 70px rgba(16, 24, 40, 0.10);

  --radius-sm: 12px;
  --radius-md: 18px;
  --radius-lg: 26px;
  --radius-xl: 32px;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Helvetica,
    Arial,
    sans-serif;
  color: var(--text);
  background:
    radial-gradient(
      circle at 8% 0%,
      rgba(79, 70, 229, 0.10),
      transparent 28%
    ),
    radial-gradient(
      circle at 95% 5%,
      rgba(99, 102, 241, 0.08),
      transparent 25%
    ),
    var(--bg);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button,
input,
select,
textarea {
  -webkit-tap-highlight-color: transparent;
}

/* HEADER */

.header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.84);
  border-bottom: 1px solid rgba(230, 232, 240, 0.8);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.header-inner {
  width: min(100%, 1080px);
  min-height: 76px;
  margin: 0 auto;
  padding: 14px 18px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.brand-mark {
  width: 44px;
  height: 44px;
  min-width: 44px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #fff;
  background:
    linear-gradient(145deg, #6366f1, #4338ca);
  border-radius: 14px;

  font-size: 21px;
  font-weight: 900;
  letter-spacing: -1px;

  box-shadow:
    0 9px 22px rgba(79, 70, 229, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.22);
}

.brand-text {
  min-width: 0;
}

.brand-text strong {
  display: block;
  color: var(--text);
  font-size: 17px;
  line-height: 1.15;
  letter-spacing: -0.45px;
}

.brand-text span {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.2;
  font-weight: 600;
}

.header-pill {
  display: flex;
  align-items: center;
  gap: 8px;

  padding: 8px 12px;

  color: var(--muted);
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid var(--border);
  border-radius: 999px;

  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #12b76a;
  box-shadow: 0 0 0 4px rgba(18, 183, 106, 0.10);
}

/* MAIN */

.container {
  width: min(100%, 1080px);
  margin: 0 auto;
  padding: 18px 15px 70px;
}

.hidden {
  display: none !important;
}

.muted {
  color: var(--muted);
}

/* HERO */

.welcome {
  position: relative;
  overflow: hidden;
  padding: 44px 7px 34px;
  margin-bottom: 8px;
}

.hero-glow {
  position: absolute;
  width: 280px;
  height: 280px;
  right: -150px;
  top: -135px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(99, 102, 241, 0.16),
      rgba(99, 102, 241, 0.02) 60%,
      transparent 72%
    );

  pointer-events: none;
}

.welcome-badge {
  position: relative;

  display: inline-flex;
  align-items: center;

  padding: 7px 11px;
  margin-bottom: 17px;

  color: var(--primary);
  background: rgba(238, 242, 255, 0.88);
  border: 1px solid #dfe3ff;
  border-radius: 999px;

  font-size: 9px;
  font-weight: 850;
  letter-spacing: 1.4px;
}

.welcome h1 {
  position: relative;
  max-width: 760px;

  color: var(--text);
  font-size: clamp(40px, 11vw, 68px);
  line-height: 0.99;
  letter-spacing: -2.8px;
  font-weight: 900;

  margin-bottom: 18px;
}

.welcome h1 span {
  color: var(--primary);
}

.welcome > p {
  position: relative;
  max-width: 650px;

  color: var(--muted);
  font-size: 15px;
  line-height: 1.7;
}

/* LEARNING PATH */

.learning-path {
  position: relative;

  display: flex;
  align-items: center;
  gap: 10px;

  max-width: 680px;
  margin-top: 29px;
}

.path-item {
  display: flex;
  align-items: center;
  gap: 9px;
}

.path-number {
  width: 33px;
  height: 33px;
  min-width: 33px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: var(--primary);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 11px;

  font-size: 9px;
  font-weight: 900;

  box-shadow: var(--shadow-sm);
}

.path-item strong {
  display: block;
  font-size: 12px;
  line-height: 1.1;
}

.path-item span {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.1;
}

.path-line {
  width: 34px;
  height: 1px;
  background: var(--border-strong);
}

/* CARDS */

.card {
  position: relative;

  background: rgba(255, 255, 255, 0.94);
  border: 1px solid rgba(230, 232, 240, 0.95);
  border-radius: var(--radius-lg);

  padding: 21px;
  margin-bottom: 16px;

  box-shadow: var(--shadow-md);
}

.card h2 {
  color: var(--text);
  font-size: 20px;
  line-height: 1.2;
  letter-spacing: -0.55px;
  margin-bottom: 7px;
}

.card > p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
  margin-bottom: 19px;
}

.section-label {
  display: inline-flex;
  align-items: center;

  color: var(--primary);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.25px;

  margin-bottom: 8px;
}

.welcome + .card {
  margin-top: 3px;
}

.welcome + .card::before {
  content: "START HERE";

  display: block;
  width: fit-content;

  margin-bottom: 9px;

  color: var(--primary);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.3px;
}

/* FORM */

/* Learning setup panel */
.setup-panel {
  margin-top: 2.5rem;
}

.setup-panel-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.setup-panel-top > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.panel-label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: #5148d8;
}

.setup-panel-top strong {
  font-size: 1.05rem;
  line-height: 1.25;
}

.panel-symbol {
  width: 2.75rem;
  height: 2.75rem;
  flex: 0 0 2.75rem;
  display: grid;
  place-items: center;
  border-radius: 0.9rem;
  font-weight: 800;
  font-size: 1.1rem;
  color: #ffffff;
  background: linear-gradient(135deg, #6259e8, #4038b8);
  box-shadow: 0 8px 20px rgba(64, 56, 184, 0.2);
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 15px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.field label,
label {
  color: var(--text-soft);
  font-size: 12px;
  font-weight: 750;
}

input,
select,
textarea {
  width: 100%;

  color: var(--text);
  background: var(--surface);

  border: 1px solid var(--border);
  border-radius: var(--radius-sm);

  padding: 13px 14px;
  outline: none;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease,
    background 0.2s ease;
}

input::placeholder,
textarea::placeholder {
  color: #98a2b3;
}

input:hover,
select:hover,
textarea:hover {
  border-color: var(--border-strong);
}

input:focus,
select:focus,
textarea:focus {
  background: #fff;
  border-color: rgba(79, 70, 229, 0.65);

  box-shadow:
    0 0 0 4px rgba(79, 70, 229, 0.09),
    var(--shadow-sm);
}

textarea {
  min-height: 132px;
  resize: vertical;
}

/* BUTTONS */

button.primary,
.primary {
  width: 100%;

  border: 0;
  border-radius: 14px;

  padding: 14px 18px;

  color: #fff;
  background:
    linear-gradient(135deg, #6366f1, #4338ca);

  font-size: 14px;
  font-weight: 800;

  box-shadow:
    0 10px 22px rgba(79, 70, 229, 0.20),
    inset 0 1px 0 rgba(255, 255, 255, 0.18);

  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    filter 0.18s ease;
}

button.primary:hover,
.primary:hover {
  filter: brightness(1.04);
  box-shadow:
    0 14px 28px rgba(79, 70, 229, 0.24),
    inset 0 1px 0 rgba(255, 255, 255, 0.18);
}

button.primary:active,
.primary:active {
  transform: translateY(1px) scale(0.985);
}

button.secondary,
.secondary {
  border: 1px solid var(--border);
  border-radius: 13px;

  padding: 12px 16px;

  color: var(--text-soft);
  background: var(--surface);

  font-weight: 750;

  box-shadow: var(--shadow-sm);
}

.button-row {
  display: flex;
  gap: 10px;
  margin-top: 17px;
}

.status {
  margin-top: 12px;
  font-size: 13px;
}

.error {
  color: var(--danger);
  background: var(--danger-soft);
  border: 1px solid #fecdca;
  border-radius: 13px;
  padding: 12px;
  margin-top: 12px;
  font-size: 13px;
}

.success {
  color: var(--success);
}

.loading {
  opacity: 0.62;
  pointer-events: none;
}
/* =========================================================
   LESSON — TEACHER EXPERIENCE
   ========================================================= */

.lesson-card {
  overflow: hidden;
  border-top: 0;
}

.lesson-card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 4px;
  background: linear-gradient(90deg, #6366f1, #8b5cf6, #a78bfa);
}

.lesson-card h2 {
  letter-spacing: -0.65px;
}

.lesson-intro {
  margin-bottom: 17px;
}

.lesson-content {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 17px;
  background: linear-gradient(145deg, #f6f7ff, #ffffff);
  border: 1px solid #e3e6ff;
  border-radius: var(--radius-md);
}

.lesson-icon {
  width: 39px;
  height: 39px;
  min-width: 39px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 12px;
  font-size: 18px;
}

.lesson-answer {
  margin-top: 0;
  color: var(--text-soft);
  font-size: 15px;
  line-height: 1.75;
}

.lesson-tip {
  margin-top: 14px;
  padding: 14px 15px;
  background: var(--warning-soft);
  border: 1px solid #f7e6b5;
  border-radius: 14px;
}

.lesson-tip strong {
  display: block;
  margin-bottom: 3px;
  color: #92400e;
  font-size: 12px;
}

.lesson-tip p {
  color: #7c5a20;
  font-size: 12px;
  line-height: 1.55;
}

/* =========================================================
   LEARNING SESSION
   ========================================================= */

.learning-session {
  border-top: 0;
}

.learning-session::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 4px;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
}

.learning-step {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 13px;
  color: var(--primary);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.25px;
}

.step-number {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 9px;
  font-size: 10px;
  letter-spacing: 0;
}

.learning-session h2 {
  font-size: 23px;
  letter-spacing: -0.65px;
  margin-bottom: 7px;
}

.learning-prompt {
  margin-bottom: 19px !important;
}

.question-box {
  padding: 19px;
  background: linear-gradient(145deg, #f1f3ff, #ffffff);
  border: 1px solid #dfe3ff;
  border-radius: var(--radius-md);
  margin-bottom: 20px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.question-label {
  margin-bottom: 9px;
  color: var(--primary);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.2px;
}

.question-box .question {
  color: var(--text);
  font-size: 17px;
  line-height: 1.55;
  font-weight: 750;
}

.answer-area {
  margin-top: 3px;
}

.answer-area label {
  display: block;
  margin-bottom: 7px;
}

.answer-area textarea {
  min-height: 155px;
  font-size: 15px;
  line-height: 1.65;
}

.answer-hint {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 8px;
  color: var(--muted);
  font-size: 11px;
}

.learning-submit {
  margin-top: 17px;
  padding: 15px;
}

/* =========================================================
   ASSESSMENT / FEEDBACK
   ========================================================= */

.assessment-card {
  overflow: hidden;
  border-top: 0;
}

.assessment-card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 4px;
  background: linear-gradient(90deg, #8b5cf6, #6366f1);
}

.result-heading {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 20px;
}

.result-icon {
  width: 44px;
  height: 44px;
  min-width: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 14px;
  font-size: 20px;
}

.result-heading h2 {
  font-size: 22px;
  line-height: 1.18;
  letter-spacing: -0.6px;
  margin-bottom: 5px;
}

.result-heading p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.55;
  margin: 0;
}

.score-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
  margin-bottom: 15px;
}

.score-box,
.understanding-box {
  min-height: 96px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 16px;
  background: var(--surface-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.score-box span {
  display: block;
  color: var(--primary);
  font-size: 36px;
  line-height: 1;
  letter-spacing: -1.4px;
  font-weight: 900;
}

.score-box small,
.understanding-box small {
  color: var(--muted);
  font-size: 10px;
  margin-top: 5px;
}

.understanding-box span {
  color: var(--text);
  font-size: 17px;
  line-height: 1.25;
  font-weight: 850;
}

.feedback-box,
.teaching-box,
.next-question-box {
  border-radius: var(--radius-md);
  padding: 16px;
  margin-top: 12px;
}

.feedback-box {
  background: linear-gradient(145deg, #f4f7ff, #ffffff);
  border: 1px solid #dfe6ff;
}

.feedback-box h3 {
  font-size: 13px;
  margin-bottom: 5px;
}

.feedback-box p {
  color: var(--text-soft);
  font-size: 13px;
  line-height: 1.65;
}

.learning-details {
  display: grid;
  gap: 0;
  margin-top: 14px;
}

.learning-detail {
  padding: 13px 0;
  border-top: 1px solid var(--border);
}

.learning-detail strong {
  display: block;
  color: var(--text-soft);
  font-size: 12px;
  margin-bottom: 4px;
}

.learning-detail p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.55;
}

.teaching-box {
  background: linear-gradient(145deg, #f6f3ff, #ffffff);
  border: 1px solid #e5ddff;
}

.next-step-label {
  margin-bottom: 7px;
  color: var(--primary);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.2px;
}

.teaching-box > p {
  color: var(--text-soft);
  font-size: 13px;
  line-height: 1.65;
}

.next-question-box {
  background: var(--success-soft);
  border: 1px solid #ccefe0;
}

.next-question-box strong {
  display: block;
  color: var(--success);
  font-size: 9px;
  letter-spacing: 0.9px;
  text-transform: uppercase;
  margin-bottom: 5px;
}

.next-question-box p {
  color: var(--text-soft);
  font-size: 13px;
  line-height: 1.6;
}

.assessment-card > .primary {
  margin-top: 17px;
}

/* =========================================================
   DASHBOARD
   ========================================================= */

.dashboard-card {
  margin-top: 24px;
}

.dashboard-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.dashboard-heading h2 {
  font-size: 24px;
  letter-spacing: -0.65px;
  margin-bottom: 3px;
}

.dashboard-heading p {
  margin-bottom: 0 !important;
  font-size: 12px;
}

.dashboard-refresh {
  width: 40px;
  height: 40px;
  min-width: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 13px;
  font-size: 19px;
  box-shadow: var(--shadow-sm);
  transition: transform 0.18s ease, background 0.18s ease;
}

.dashboard-refresh:hover {
  background: var(--primary-soft);
}

.dashboard-refresh:active {
  transform: rotate(20deg);
}

.learning-summary {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  margin-bottom: 15px;
  background: linear-gradient(145deg, #f1f3ff, #ffffff);
  border: 1px solid #dfe3ff;
  border-radius: var(--radius-md);
}

.summary-icon {
  width: 39px;
  height: 39px;
  min-width: 39px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 12px;
  font-size: 18px;
}

.learning-summary strong {
  display: block;
  color: var(--text);
  font-size: 13px;
  margin-bottom: 3px;
}

.learning-summary p {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.55;
}

.dashboard-section {
  margin-top: 25px;
}

.dashboard-section-title {
  color: var(--muted);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.25px;
  margin-bottom: 10px;
}

.dashboard-card .stats {
  margin-bottom: 0;
}

.dashboard-card .stat {
  padding: 15px;
  background: var(--surface-soft);
  border: 1px solid var(--border);
  border-radius: 15px;
}

.dashboard-card .stat span {
  color: var(--muted);
  font-size: 10px;
}

.dashboard-card .stat strong {
  display: block;
  color: var(--text);
  font-size: 20px;
  line-height: 1.1;
  margin-top: 5px;
}

/* =========================================================
   RECOMMENDATION
   ========================================================= */

.recommendation {
  background: linear-gradient(145deg, #f4f6ff, #ffffff);
  border: 1px solid #dfe3ff;
  border-radius: var(--radius-md);
  padding: 16px;
}

.dashboard-recommendation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.recommendation-content {
  flex: 1;
}

.recommendation-content strong {
  display: block;
  color: var(--text);
  font-size: 13px;
  margin-bottom: 4px;
}

.recommendation-content p {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.55;
  margin: 0;
}

.recommendation-action {
  flex-shrink: 0;
  border: 0;
  border-radius: 12px;
  padding: 10px 14px;
  color: #fff;
