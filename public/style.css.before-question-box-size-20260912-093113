/* =========================================================
   DREAM EDUCATION — LEARNING EXPERIENCE UPGRADE
   ========================================================= */

.live-learning-panel {
  position: relative;
  overflow: hidden;
}

.live-learning-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 90% 5%, rgba(255,255,255,.08), transparent 28%),
    radial-gradient(circle at 10% 90%, rgba(255,255,255,.05), transparent 30%);
}

.live-learning-header {
  position: relative;
  z-index: 1;
}

.learning-state-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .3px;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.12);
}

.learning-controls {
  position: relative;
  z-index: 1;
}

.learning-controls label {
  display: block;
  margin-bottom: 7px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .2px;
  opacity: .8;
}

.learning-controls input,
.learning-controls select,
.learning-controls textarea,
.answer-area textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 14px;
  padding: 13px 14px;
  border: 1px solid rgba(255,255,255,.12);
  outline: none;
  transition: border-color .2s, box-shadow .2s, transform .2s;
}

.learning-controls input:focus,
.learning-controls select:focus,
.learning-controls textarea:focus,
.answer-area textarea:focus {
  border-color: rgba(255,255,255,.35);
  box-shadow: 0 0 0 3px rgba(255,255,255,.06);
}

.learning-question-box {
  position: relative;
  margin-top: 18px;
  padding: 18px;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,.10);
}

.learning-question-box::before {
  content: "YOUR LEARNING TASK";
  display: block;
  margin-bottom: 8px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
  opacity: .55;
}

.learning-response {
  position: relative;
  margin-top: 18px;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,.10);
  overflow: hidden;
}

.response-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  padding: 12px 16px;
  border-bottom: 1px solid rgba(255,255,255,.08);
  font-size: 12px;
  font-weight: 700;
  opacity: .8;
}

.teaching-answer {
  padding: 20px;
  line-height: 1.75;
  white-space: pre-wrap;
}

.answer-area {
  position: relative;
  margin-top: 18px;
}

.answer-area::before {
  content: "YOUR TURN";
  display: block;
  margin-bottom: 8px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
  opacity: .55;
}

.adaptive-result {
  position: relative;
  margin-top: 18px;
  padding: 18px;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,.10);
}

.adaptive-result:not(.hidden) {
  animation: learningResultIn .35s ease-out;
}

@keyframes learningResultIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.live-learning-panel button {
  transition: transform .15s ease, opacity .15s ease, box-shadow .15s ease;
}

.live-learning-panel button:hover {
  transform: translateY(-1px);
}

.live-learning-panel button:active {
  transform: translateY(1px);
}

.hidden {
  display: none !important;
}

@media (max-width: 760px) {
  .live-learning-panel {
    border-radius: 20px;
  }

  .learning-question-box,
  .teaching-answer,
  .adaptive-result {
    padding: 15px;
  }

  .learning-controls input,
  .learning-controls select,
  .learning-controls textarea,
  .answer-area textarea {
    font-size: 16px;
  }
}


