  "global_routing_order": [
    "analyze_problem",
    "identify_domain",
    "identify_problem_type",
    "select_specialist",
    "select_relevant_local_solvers",
    "select_relevant_evidence_sources",
    "solve",
    "verify",
    "crosscheck",
    "format_steps",
    "return_verified_solution"
