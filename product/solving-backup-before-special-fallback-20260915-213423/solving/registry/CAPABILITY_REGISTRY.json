  "failure_policy": {
    "local_solver_failure": "try_next_relevant_solver",
    "verification_failure": "reject_solution",
    "inconclusive_verification": "try_alternative_method",
    "all_internal_methods_failed": "external_special_problem_solver",
    "external_result": "must_be_independently_verified",
    "unverified_result": "never_teach_as_fact"
  }
